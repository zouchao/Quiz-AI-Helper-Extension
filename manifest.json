{
  "manifest_version": 3,
  "name": "Quiz AI Helper - AI做题助手",
  "version": "3.2",
  "description": "加载PDF参考文档，AI理解内容后根据页面题目自动作答",
  "author": "Sean Zou <zouchao2008@gmail.com>",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/pdf.worker.min.js", "images/buy-me-a-coffee.jpeg"],
      "matches": ["https://*/*"]
    }
  ]
}
